# Example environment variables for local development
# Copy to .env.local and update values before running

# NextAuth
NEXTAUTH_SECRET=change_this_to_a_strong_secret
# NEXTAUTH_URL is optional in dev; set in production (e.g. https://your-domain.com)
# NEXTAUTH_URL=http://localhost:3000

# Database (optional - required if you enable Prisma adapter)
# Example for PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Email provider (only required if using EmailProvider)
# EMAIL_SERVER_HOST=smtp.example.com
# EMAIL_SERVER_PORT=587
# EMAIL_SERVER_SECURE=false
# EMAIL_SERVER_USER=your_smtp_user
# EMAIL_SERVER_PASSWORD=your_smtp_password
# EMAIL_FROM=no-reply@example.com

# Google OAuth (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Debug helpers
# Set to true only in development to enable /api/debug/token
DEBUG_TOKEN=false
