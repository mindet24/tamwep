# Copy this file to .env and fill the real values. Do NOT commit .env with secrets.
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# NextAuth
NEXTAUTH_SECRET=devsecret

# Contact
CONTACT_EMAIL=20778@mh.ac.th

# (Optional) SMTP settings for real email sending
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_SERVER_SECURE=false

# Ollama (local LLM)
# Example: run Ollama locally and set URL to http://localhost:11434
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama2
USE_OLLAMA=0

# Redis (optional) for quota and caching
REDIS_URL=redis://localhost:6379
LLM_QUOTA_PER_HOUR=20
